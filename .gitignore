## A streamlined .gitignore for modern .NET + React/Next.js projects
## including temporary files, build results, IDE files,
## Node.js dependencies, and generated artifacts.

# =========================
# .NET Build results
# =========================

[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
*.snupkg

# MSBuild Binary and Structured Log
*.binlog

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
*.TestResult.xml


# =========================
# Environment & OS files
# =========================

.DS_Store
.env
.env.*
!.env.example

# ASP.NET Core configs with secrets
appsettings.Development.json
application.Development.json


# =========================
# Node.js / React / Next.js
# =========================

# Dependencies
node_modules/
jspm_packages/

# Next.js
.next/
out/

# Production build
dist/
build/

# Cache
.npm/
.yarn/
.pnpm-store/
.cache/
.parcel-cache/

# TypeScript
*.tsbuildinfo

# ESLint cache
.eslintcache

# Vite
.vite/

# Storybook
.storybook-static/


# =========================
# Package manager files
# =========================

# Uncomment if you don't want to commit lock files
# package-lock.json
# yarn.lock
# pnpm-lock.yaml


# =========================
# Editors / IDE
# =========================

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / JetBrains
.idea/
*.sln.iml
*.csproj.iws
*.userprefs
*.DotSettings
*.DotSettings.user
_ReSharper.*
*.rider/

/.idea/.idea.*/.idea/
/.idea/modules.xml
/.idea/workspace.xml
/.idea/vcs.xml
/.idea/shelf/

# VS Code
.vscode/


# =========================
# Temporary files
# =========================

~$*
*~
*.tmp
*.temp
*.swp

# Coverage
CodeCoverage/
coverage/
.nyc_output/


# =========================
# Logs
# =========================

*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
